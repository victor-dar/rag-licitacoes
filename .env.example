# Sem LLM_API_KEY a API funciona em modo extrativo (devolve só os trechos).

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Ollama rodando no host (exemplo)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Troque o modelo de embeddings (precisa reindexar)
# EMBED_MODEL=intfloat/multilingual-e5-base

# Token usado pelo n8n para chamar POST /reindex
ADMIN_TOKEN=troque-este-token
